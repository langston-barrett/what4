// `lowerBound` goes through `arcMeetClosed`, which uses
// `solveLinearDiophantine`, which symbolically unfolds the eGCD iteration
// `4*n + 4` deep. Most properties that involve a Diophantine call on /both/
// sides of the equation (commutative, topIdentity, soundness, leqExactBoth)
// don't terminate within reasonable time even at w=2. Only
// `lowerBoundIdempotent` is registered for proof — its `lowerBound a a`
// short-circuits in the matching-bases branch of `arcMeetClosed` and
// avoids the Diophantine path.
//
// The Haskell implementation has matching property tests that run via
// Hedgehog at all widths up to 8; the @correct_lowerBound@ /under/-approx
// soundness in particular is exhaustively covered there.
property p_lowerBoundIdempotent                    = lowerBoundIdempotent`{2}

property p_trimSelfWrapNotSelfWrapping              = trimSelfWrapNotSelfWrapping`{4}
property p_trimSelfWrapSubset                       = trimSelfWrapSubset`{4}
property p_trimSelfWrapIdentity                     = trimSelfWrapIdentity`{4}
property p_trimSelfWrapIdempotent                   = trimSelfWrapIdempotent`{4}


// ------------------------------------------------------------------
// * Precision (Strides at least as precise as Arith)

// ------------------------------------------------------------------
// ** Arithmetic

precise_negate : {n} (fin n, n >= 2) => Domain n -> Property
precise_negate a =
  proper a ==> size (neg a) <= Arith::size (Arith::neg (hull a))

precise_add : {n} (fin n, n >= 2) => Domain n -> Domain n -> Property
precise_add a b =
  proper a ==> proper b ==>
    size (add a b) <= Arith::size (Arith::add (hull a) (hull b))

precise_sub : {n} (fin n, n >= 2) => Domain n -> Domain n -> Property
precise_sub a b =
  proper a ==> proper b ==>
    size (sub a b) <= Arith::size (Arith::add (hull a) (Arith::neg (hull b)))

precise_udiv : {n} (fin n, n >= 2) => Domain n -> Domain n -> Property
precise_udiv a b =
  proper a ==> proper b ==>
    size (udiv a b) <= Arith::size (Arith::udiv (hull a) (hull b))

precise_urem : {n} (fin n, n >= 2) => Domain n -> Domain n -> Property
precise_urem a b =
  proper a ==> proper b ==>
    size (urem a b) <= Arith::size (Arith::urem (hull a) (hull b))

precise_sdiv : {n} (fin n, n >= 2) => Domain n -> Domain n -> Property
precise_sdiv a b =
  proper a ==> proper b ==>
    size (sdiv a b) <= Arith::size (Arith::sdiv (hull a) (hull b))

precise_srem : {n} (fin n, n >= 2) => Domain n -> Domain n -> Property
precise_srem a b =
  proper a ==> proper b ==>
    size (srem a b) <= Arith::size (Arith::srem (hull a) (hull b))

property p_precise_negate = precise_negate`{4}
property p_precise_add    = precise_add`{4}
property p_precise_sub    = precise_sub`{4}
property p_precise_udiv   = precise_udiv`{4}
property p_precise_urem   = precise_urem`{4}
property p_precise_sdiv   = precise_sdiv`{4}
property p_precise_srem   = precise_srem`{4}

// ------------------------------------------------------------------
// ** Concatenation, extension, selection, and truncation

precise_zext : {m, n} (fin m, m >= n, n >= 2, m >= 2) => Domain n -> Property
precise_zext a =
  proper a ==>
    size (zero_ext`{m} a) <= Arith::size (Arith::zero_ext`{m} (hull a))

precise_sext : {m, n} (fin m, m >= n, n >= 2, m >= 2) => Domain n -> Property
precise_sext a =
  proper a ==>
    size (sign_ext`{m} a) <= Arith::size (Arith::sign_ext`{m} (hull a))

precise_concat : {m, n} (fin m, fin n, m >= 2, n >= 2) => Domain m -> Domain n -> Property
precise_concat a b =
  proper a ==> proper b ==>
    size (concat a b) <= Arith::size (Arith::concat (hull a) (hull b))

property p_precise_zext   = precise_zext`{6, 4}
property p_precise_sext   = precise_sext`{6, 4}
property p_precise_concat = precise_concat`{2, 2}

// ------------------------------------------------------------------
// ** Shifts and rotations

precise_shl : {n} (fin n, n >= 2) => Domain n -> Domain n -> Property
precise_shl a b =
  proper a ==> proper b ==>
    size (shl a b) <= Arith::size (Arith::shl (hull a) (hull b))

precise_lshr : {n} (fin n, n >= 2) => Domain n -> Domain n -> Property
precise_lshr a b =
  proper a ==> proper b ==>
    size (lshr a b) <= Arith::size (Arith::lshr (hull a) (hull b))

precise_ashr : {n} (fin n, n >= 2) => Domain n -> Domain n -> Property
precise_ashr a b =
  proper a ==> proper b ==>
    size (ashr a b) <= Arith::size (Arith::ashr (hull a) (hull b))

// Disabled for the same reason as @p_correct_shl@: @shl@ reduces to @mul@,
// which times out the solver even at @w = 2@.
// property p_precise_shl  = precise_shl`{4}
property p_precise_lshr = precise_lshr`{4}
property p_precise_ashr = precise_ashr`{4}

// ------------------------------------------------------------------
// * Subset properties

// ------------------------------------------------------------------
// ** Arithmetic

subset_negate : {n} (fin n, n >= 2) => Domain n -> [n] -> Property
subset_negate a x =
  proper a ==> member (neg a) x ==>
    Arith::mem (Arith::neg (toArith a)) x

subset_urem : {n} (fin n, n >= 2) => Domain n -> Domain n -> [n] -> Property
subset_urem a b x =
  proper a ==> proper b ==> member (urem a b) x ==>
    Arith::mem (Arith::urem (toArith a) (toArith b)) x

subset_srem : {n} (fin n, n >= 2) => Domain n -> Domain n -> [n] -> Property
subset_srem a b x =
  proper a ==> proper b ==> member (srem a b) x ==>
    Arith::mem (Arith::srem (toArith a) (toArith b)) x

property p_subset_negate = subset_negate`{4}
property p_subset_urem   = subset_urem`{4}
property p_subset_srem   = subset_srem`{4}

// No @subset_udiv@ / @subset_sdiv@: the closed-form division results keep coset
// structure that is generally incomparable with the interval returned by
// @Arith::{u,s}div (toArith a) (toArith b)@. Soundness is covered by
// @correct_udiv@ / @correct_sdiv@ instead.

// ------------------------------------------------------------------
// ** Concatenation, extension, selection, and truncation

subset_zext : {m, n} (fin m, m >= n, n >= 2, m >= 2) => Domain n -> [m] -> Property
subset_zext a x =
  proper a ==> member (zero_ext`{m} a) x ==>
    Arith::mem (Arith::zero_ext`{m} (toArith a)) x

// (No @subset_sext@ / @subset_concat@ / @subset_select@ — when the arith
// arc wraps modulo the target width, the forced-bits refinement in these
// conversions can return a progression that is smaller by cardinality but
// not contained in the arith arc. @subset_zext@ still holds because the
// zero-extended arith arc never wraps at the wider width.)

property p_subset_zext   = subset_zext`{6, 4}

// ------------------------------------------------------------------
// ** Shifts and rotations

// These check the @*Raw@ kernel against the arith abstraction; the
// 'psplitOp2R'-wrapped public versions (@lshr@ etc.) can soundly land on a
// coset that the arith arc does not contain.
//
// (No @subset_shl@ — @shlRaw@ keeps the mul-based candidate whenever it is
// smaller by cardinality, even when it is not contained in the arith arc.
// Soundness is covered by @correct_shl@.)
subset_lshr : {n} (fin n, n >= 2) => Domain n -> Domain n -> [n] -> Property
subset_lshr a b x =
  proper a ==> proper b ==> member (lshrRaw a b) x ==>
    Arith::mem (Arith::lshr (toArith a) (toArith b)) x

subset_ashr : {n} (fin n, n >= 2) => Domain n -> Domain n -> [n] -> Property
subset_ashr a b x =
  proper a ==> proper b ==> member (ashrRaw a b) x ==>
    Arith::mem (Arith::ashr (toArith a) (toArith b)) x

property p_subset_lshr = subset_lshr`{4}
property p_subset_ashr = subset_ashr`{4}
