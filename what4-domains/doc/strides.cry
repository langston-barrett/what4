// Equality of `Maybe (Domain n)` via `leqExact` on the `Just` payloads.
eqMaybeAssume :
  {n} (fin n, n >= 2) => Maybe (Domain n) -> Maybe (Domain n) -> Bit
eqMaybeAssume mx my = case mx of
  Nothing -> case my of
    Nothing -> True
    Just _  -> False
  Just x -> case my of
    Nothing -> False
    Just y  -> leqExact x y /\ leqExact y x

assumeUltIdempotent :
  {n} (fin n, n >= 2) => Domain n -> Domain n -> Property
assumeUltIdempotent a b =
  proper a ==> proper b ==>
    ~ (wraps a) ==> ~ (wraps b) ==>
      case assumeUlt a b of
        Nothing -> True
        Just c  -> eqMaybeAssume (assumeUlt c b) (Just c)

assumeUleIdempotent :
  {n} (fin n, n >= 2) => Domain n -> Domain n -> Property
assumeUleIdempotent a b =
  proper a ==> proper b ==>
    ~ (wraps a) ==> ~ (wraps b) ==>
      case assumeUle a b of
        Nothing -> True
        Just c  -> eqMaybeAssume (assumeUle c b) (Just c)

