// A spec for "What4.Domains.BV.GeoStrides".
//
// The geometric-strides kernel represents nonempty sets of NONZERO bitvectors
// via the multiplicative factorization
//
//     x = 2^v * (-1)^kappa * 5^k   (mod 2^w),     valid for w >= 3,
//
// where v = ctz(x) in [0,w), kappa in {0,1} is the mod-4 class of the odd part,
// and k in [0, 2^{w-2}) is the base-5 discrete log of the odd part.
//
// This is a reference spec proven at width 4. The abstract domain is modelled
// by characteristic predicates over the three coordinates; membership and the
// abstract operations are defined from the factorization, and the @correct_*@
// predicates mirror the Haskell soundness properties.
//
// Prove with: cryptol doc/geostrides.cry -c :prove
module geostrides where

type Property = Bit

// ------------------------------------------------------------------
// 2-adic discrete log / exp.

// 5^k mod 2^n by repeated squaring (fold over the n exponent bits).
pow5 : {n} (fin n, n >= 3) => [n] -> [n]
pow5 k = ps ! 0
  where
    // running products: acc after consuming each bit, low bit first
    ps = [1] # [ if (k >> i) ! 0 then acc * (sq @ i) else acc
               | acc <- ps
               | i <- [0 .. n-1] ]
    // sq @ i = 5^(2^i) mod 2^n
    sq = [5] # [ s * s | s <- sq ]

// ------------------------------------------------------------------
// The mod-4 class coordinate (the (-1)^kappa factor), with a top element.

type OddClass = [2]
oneMod4   = 0 : OddClass   // odd part = 1 (mod 4)   (kappa = 0)
threeMod4 = 1 : OddClass   // odd part = 3 (mod 4)   (kappa = 1)
ocTop     = 2 : OddClass   // either class

oddClassAdmits : OddClass -> OddClass -> Bit
oddClassAdmits oc c = (oc == ocTop) \/ (oc == c)

// kappa group operation (xor), lifted over top.
oddClassMul : OddClass -> OddClass -> OddClass
oddClassMul a b =
  if (a == ocTop) \/ (b == ocTop) then ocTop
   | a == oneMod4 then b
   | b == oneMod4 then a
  else oneMod4   // threeMod4 * threeMod4

oddClassJoin : OddClass -> OddClass -> OddClass
oddClassJoin a b = if a == b then a else ocTop

flipClass : OddClass -> OddClass
flipClass oc = oddClassMul threeMod4 oc

// ------------------------------------------------------------------
// Abstract domain: a characteristic bit-mask for each coordinate axis.
//
// Using bit-masks (rather than functions) keeps 'Domain' first-order, so the
// SMT prover can range over domains directly in @:prove@. Bit @i@ of @valMask@
// is set iff valuation @i@ is in the set; likewise @logMask@ for discrete-logs.
//
//   valMask i  ~  is valuation i in the set?  (only i < w are meaningful)
//   oddClass   ~  the admitted mod-4 class
//   logMask i  ~  is discrete-log i in the set?  (only i mod 2^{w-2} matters)

type Domain n =
  { valMask  : [2^^n]
  , oddClass : OddClass
  , logMask  : [2^^n]
  }

// Is index @i@ set in a characteristic mask? Masks are built by comprehensions
// over @allVals = [0 .. 2^n-1]@, so position @i@ (from the front) is index @i@.
hasIdx : {n} (fin n) => [2^^n] -> [n] -> Bit
hasIdx mask i = mask @ i

hasVal : {n} (fin n) => Domain n -> [n] -> Bit
hasVal d = hasIdx d.valMask

hasLog : {n} (fin n) => Domain n -> [n] -> Bit
hasLog d = hasIdx d.logMask

// Concrete valuation (count of trailing zeros) of a nonzero value.
valuation : {n} (fin n, n >= 1) => [n] -> [n]
valuation x = vs ! 0
  where vs = [0] # [ if x ! 0 then v else v + 1 | v <- vs | _ <- [1 .. n] ]

// Recompose coordinates into a concrete value.
recompose : {n} (fin n, n >= 3) => [n] -> OddClass -> [n] -> [n]
recompose v oc k = odd << v
  where
    p = pow5 k
    odd = if oc == threeMod4 then - p else p

// All width-n bitvectors (finite; the prover enumerates these at small n).
allVals : {n} (fin n) => [2^^n][n]
allVals = [ 0 .. 2^^n - 1 ]

// Membership: x is a member iff it is nonzero and some coordinate triple in the
// set recomposes to it. (Stated as a finite existential, mirroring the Haskell
// 'member' which computes this in closed form.)
member : {n} (fin n, n >= 3) => Domain n -> [n] -> Bit
member d x =
  (x != 0) /\
  or [ hasVal d v /\ oddClassAdmits d.oddClass c /\ hasLog d k /\ recompose v c k == x
     | v <- allVals
     , c <- [oneMod4, threeMod4]
     , k <- allVals ]

// ------------------------------------------------------------------
// Abstract operations on the coordinate masks.

negD : {n} (fin n) => Domain n -> Domain n
negD d = { valMask = d.valMask, oddClass = flipClass d.oddClass, logMask = d.logMask }

// The Minkowski sum of two masks under index addition, keeping only sums @< w@
// (a valuation @>= w@ denotes the value 0, which leaves the nonzero kernel).
valSumMask : {n} (fin n, n >= 1) => [2^^n] -> [2^^n] -> [2^^n]
valSumMask ma mb =
  [ or [ hasIdx ma va /\ hasIdx mb vb /\ (va + vb == v) /\ (va + vb < `n)
       | va <- allVals, vb <- allVals ]
  | v <- allVals ]

// The Minkowski sum of two masks under index addition (mod 2^n) — used for the
// log axis, where addition is modular.
idxSumMask : {n} (fin n, n >= 1) => [2^^n] -> [2^^n] -> [2^^n]
idxSumMask ma mb =
  [ or [ hasIdx ma ka /\ hasIdx mb kb /\ (ka + kb == k)
       | ka <- allVals, kb <- allVals ]
  | k <- allVals ]

// Multiplication combines coordinates: valuations add (over the integers, so a
// sum >= w denotes 0 and is dropped from the nonzero result), classes multiply,
// logs add modulo 2^{w-2}.
mulD : {n} (fin n, n >= 3) => Domain n -> Domain n -> Domain n
mulD a b =
  { valMask  = valSumMask a.valMask b.valMask
  , oddClass = oddClassMul a.oddClass b.oddClass
  , logMask  = idxSumMask a.logMask b.logMask
  }

joinD : {n} (fin n) => Domain n -> Domain n -> Domain n
joinD a b =
  { valMask  = a.valMask || b.valMask
  , oddClass = oddClassJoin a.oddClass b.oddClass
  , logMask  = a.logMask || b.logMask
  }

// ------------------------------------------------------------------
// Soundness properties (mirror the Haskell @correct_*@). Each says: the
// abstract result accounts for the corresponding concrete result.

correct_neg : {n} (fin n, n >= 3) => Domain n -> [n] -> Property
correct_neg a x =
  member a x ==> ((- x) == 0 \/ member (negD a) (- x))

correct_mul : {n} (fin n, n >= 3) => Domain n -> [n] -> Domain n -> [n] -> Property
correct_mul a x b y =
  member a x ==> member b y ==> ((x * y) == 0 \/ member (mulD a b) (x * y))

correct_square : {n} (fin n, n >= 3) => Domain n -> [n] -> Property
correct_square a x =
  member a x ==> ((x * x) == 0 \/ member (mulD a a) (x * x))

correct_pseudoJoin : {n} (fin n, n >= 3) => Domain n -> [n] -> Domain n -> [n] -> Property
correct_pseudoJoin a x b y =
  (member a x ==> member (joinD a b) x) /\
  (member b y ==> member (joinD a b) y)

// ------------------------------------------------------------------
// Property instances (proven at width 4: w-2 = 2, so the log axis is nontrivial
// and 5 has order 4). Multiplicative-mul/join properties enumerate all triples,
// so they are kept at width 4.

property p_correct_neg        = correct_neg`{4}
property p_correct_mul        = correct_mul`{4}
property p_correct_square     = correct_square`{4}
property p_correct_pseudoJoin = correct_pseudoJoin`{4}
